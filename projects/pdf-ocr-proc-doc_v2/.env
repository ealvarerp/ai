# Azure identity
PDF_RAG_AZURE_TENANT_ID=
PDF_RAG_AZURE_CLIENT_ID=
PDF_RAG_AZURE_CLIENT_SECRET=

# Blob Storage
PDF_RAG_BLOB_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
PDF_RAG_BLOB_CONTAINER=pdf-documents

# Azure AI Search
PDF_RAG_SEARCH_ENDPOINT=https://your-search.search.windows.net
PDF_RAG_SEARCH_API_KEY=
PDF_RAG_SEARCH_INDEX=pdf-rag-index

# Cosmos DB
PDF_RAG_COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
PDF_RAG_COSMOS_DATABASE=pdf-rag
PDF_RAG_COSMOS_CONTAINER=document-metadata

# SQL audit
PDF_RAG_SQL_CONNECTION_STRING=sqlite:///./audit.db

# Redis
PDF_RAG_REDIS_URL=redis://localhost:6379/0

# Azure AI Document Intelligence
PDF_RAG_DOC_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com
PDF_RAG_DOC_INTELLIGENCE_KEY=

# Azure OpenAI
PDF_RAG_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
PDF_RAG_OPENAI_API_KEY=
PDF_RAG_OPENAI_API_VERSION=2024-10-21
PDF_RAG_EMBEDDING_DEPLOYMENT=text-embedding-3-small
PDF_RAG_CHAT_DEPLOYMENT=gpt-4o

# Content Safety optional
PDF_RAG_CONTENT_SAFETY_ENDPOINT=
PDF_RAG_CONTENT_SAFETY_KEY=

# Processing settings
PDF_RAG_MAX_CHUNK_TOKENS=800
PDF_RAG_MAX_PAGES_PER_BATCH=25
PDF_RAG_MIN_OCR_CONFIDENCE=0.75
PDF_RAG_QUERY_TOP_K=8
PDF_RAG_CACHE_TTL_SECONDS=3600
